// Relay Status Monitor - Sub2API 账号可观测数据模型
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 枚举 ============

/// 告警严重级别
enum Severity {
  INFO
  WARNING
  CRITICAL
}

enum Sub2ApiAccountSyncState {
  ACTIVE
  RETIRED
}

enum AccountSyncRunType {
  ACCOUNT
  METRIC
  REBUILD
}

enum AccountSyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AccountMetricSnapshotWindow {
  TODAY
  LAST_1H
  LAST_24H
}

enum AccountBalanceMode {
  AUTO
  SUB2API
  NEWAPI
}

enum AccountSchedulingActionType {
  PRIORITY_ADJUST
  PRIORITY_RESTORE
  PRIORITY_CAP_PAUSE
}

enum AccountSchedulingActionResult {
  SUCCESS
  FAILURE
  SAFE_SKIP
}

// ============ 核心表 ============

/// Sub2API 账号只读投影
model Sub2ApiAccount {
  id                         Int                    @id @default(autoincrement())
  sourceAccountId            String                 @unique
  name                       String
  platform                   String?
  type                       String?
  remoteStatus               String?
  schedulable                Boolean?
  priority                   Int                    @default(50)
  rateLimitedAt              DateTime?
  rateLimitResetAt           DateTime?
  overloadUntil              DateTime?
  tempUnschedulableUntil     DateTime?
  tempUnschedulableReason    String?                @db.Text
  groupIds                   Json?
  groupProjection            Json?
  alertEnabled               Boolean                @default(true)
  probeEnabled               Boolean                @default(false)
  probeStatus                String?
  probeFreshAt               DateTime?
  probeBillingScope          String?
  probeResolvedRateMultiplier Decimal?               @db.Decimal(20, 8)
  probePeakRateEnabled       Boolean?
  probePeakStart             String?
  probePeakEnd               String?
  probePeakRateMultiplier    Decimal?               @db.Decimal(20, 8)
  probeTimezone              String?
  probeLastSuccessAt         DateTime?
  syncState                  Sub2ApiAccountSyncState @default(ACTIVE)
  remoteUpdatedAt            DateTime?
  lastSyncedAt               DateTime?
  retiredAt                  DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  metricMinutes              AccountMetricMinute[]
  metricSnapshots            AccountMetricSnapshot[]
  syncRuns                   AccountSyncRun[]
  alertEvents                AccountAlertEvent[]
  alertRules                 AccountAlertRule[]
  alertCandidates            AccountAlertCandidate[]
  priorityAdjustment         AccountPriorityAdjustment?
  balanceCredential           AccountBalanceCredential?
  schedulingActionRecords     AccountSchedulingActionRecord[]

  @@index([syncState, remoteStatus])
  @@index([lastSyncedAt])
}

model AccountBalanceCredential {
  id                          Int                @id @default(autoincrement())
  accountId                   Int                @unique
  account                     Sub2ApiAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mode                        AccountBalanceMode @default(AUTO)
  newApiUserId                String?
  newApiAccessTokenCiphertext String?            @db.Text
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
}

model AccountMetricSnapshotBatch {
  id                 Int                         @id @default(autoincrement())
  windowKey          AccountMetricSnapshotWindow
  windowStart        DateTime
  windowEnd          DateTime
  lastCompleteMinute DateTime?
  computedAt         DateTime                    @default(now())
  active             Boolean                     @default(false)
  snapshots          AccountMetricSnapshot[]

  @@index([windowKey, active])
}

model AccountMetricSnapshot {
  id                 Int                        @id @default(autoincrement())
  batchId            Int
  batch              AccountMetricSnapshotBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId          Int
  account            Sub2ApiAccount             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  successCount       Int                        @default(0)
  upstreamErrorCount Int                        @default(0)
  eligibleCount      Int                        @default(0)
  availability       Float?
  errorRate          Float?
  durationP95Ms      Float?
  firstTokenP95Ms    Float?
  cacheHitRate       Float?
  userBilledUsd      Decimal                    @default(0) @db.Decimal(24, 6)
  accountBilledUsd   Decimal                    @default(0) @db.Decimal(24, 6)
  balanceUsd         Decimal?                   @db.Decimal(24, 6)
  upstreamRateMultiplier Decimal?               @db.Decimal(20, 8)
  upstreamEstimatedRateMultiplier Decimal?      @db.Decimal(20, 8)
  upstreamRateSource String?                     @db.VarChar(16)
  lastCompleteMinute DateTime?

  @@unique([batchId, accountId])
  @@index([accountId])
}

/// 每个账号每个 UTC 分钟的可重算聚合桶
model AccountMetricMinute {
  id                    Int             @id @default(autoincrement())
  accountId             Int
  account               Sub2ApiAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bucketStart           DateTime
  successCount          Int             @default(0)
  upstreamErrorCount    Int             @default(0)
  eligibleCount         Int             @default(0)
  durationCount         Int             @default(0)
  durationSumMs         BigInt          @default(0)
  durationHistogram     Json?
  firstTokenHistogram   Json?
  inputTokens           BigInt          @default(0)
  cacheReadTokens       BigInt          @default(0)
  cacheCreationTokens   BigInt          @default(0)
  userBilledUsd         Decimal         @default(0) @db.Decimal(24, 6)
  accountBilledUsd      Decimal         @default(0) @db.Decimal(24, 6)
  baseBilledUsd         Decimal         @default(0) @db.Decimal(24, 6)
  balanceUsd            Decimal?        @db.Decimal(24, 6)
  upstreamKeyUsedUsd    Decimal?        @db.Decimal(24, 6)
  upstreamKeyStandardUsd Decimal?       @db.Decimal(24, 6)
  upstreamRateMultiplier Decimal?       @db.Decimal(20, 8)
  upstreamEstimatedRateMultiplier Decimal? @db.Decimal(20, 8)
  upstreamRateSource    String?         @db.VarChar(16)
  errorStatusCounts     Json?
  errorPhaseCounts      Json?
  sourceMaxUsageId      String?
  sourceMaxErrorId      String?
  updatedAt             DateTime        @updatedAt

  @@unique([accountId, bucketStart])
  @@index([bucketStart])
}

/// 同步/采集运行记录，保存脱敏状态和窗口统计
model AccountSyncRun {
  id              Int                 @id @default(autoincrement())
  accountId       Int?
  account         Sub2ApiAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type            AccountSyncRunType
  status          AccountSyncRunStatus @default(RUNNING)
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  scanStart       DateTime?
  scanEnd         DateTime?
  readCount       Int                 @default(0)
  bucketWriteCount Int                @default(0)
  ignoredCount    Int                 @default(0)
  durationMs      Int?
  errorMessage    String?             @db.Text

  @@index([type, startedAt])
  @@index([status, startedAt])
}

/// 账号真实流量与同步状态的专属告警规则
model AccountAlertRule {
  id              Int                 @id @default(autoincrement())
  accountId       Int?
  account         Sub2ApiAccount?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name            String              @unique
  metric          String
  operator        String
  threshold       Float
  severity        Severity            @default(WARNING)
  minRequests     Int                 @default(1)
  minPromptTokens Int                 @default(0)
  cooldownMin     Int                 @default(30)
  enabled         Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  events          AccountAlertEvent[]
  candidates      AccountAlertCandidate[]

  @@index([enabled, metric])
  @@index([accountId, enabled])
  @@unique([accountId, metric])
}

/// 账号告警的触发与恢复记录
model AccountAlertEvent {
  id          Int              @id @default(autoincrement())
  accountId   Int
  account     Sub2ApiAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId      Int
  rule        AccountAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  metric      String
  severity    Severity         @default(WARNING)
  metricValue Float?
  message     String           @db.Text
  notificationDeliveries Json?
  recoveryNormalCount Int      @default(0)
  resolved    Boolean          @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([accountId, ruleId, resolved, createdAt])
  @@index([resolved, createdAt])
}

// ============ 配置表 ============

model AlertChannel {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  type      String  @default("feishu")
  config    Json
  enabled   Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OperationalAlertRule {
  id          Int                     @id @default(autoincrement())
  key         String                  @unique
  name        String
  description String                  @db.Text
  severity    Severity                @default(CRITICAL)
  enabled     Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  events      OperationalAlertEvent[]

  @@index([enabled, key])
}

model OperationalAlertEvent {
  id                     Int                  @id @default(autoincrement())
  ruleId                 Int
  rule                   OperationalAlertRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  subjectKey             String
  subjectName            String
  detail                 String               @db.Text
  recoveryDetail         String?              @db.Text
  severity               Severity             @default(CRITICAL)
  firstTriggeredAt       DateTime             @default(now())
  lastFailedAt           DateTime             @default(now())
  failureCount           Int                  @default(1)
  resolved               Boolean              @default(false)
  resolvedAt             DateTime?
  notificationDeliveries Json?

  @@index([ruleId, subjectKey, resolved])
  @@index([resolved, firstTriggeredAt])
  @@index([severity, firstTriggeredAt])
}

model AccountSchedulingActionRecord {
  id                 Int                           @id @default(autoincrement())
  accountId          Int?
  account            Sub2ApiAccount?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  sourceAccountId    String
  accountName        String
  actionType         AccountSchedulingActionType
  result             AccountSchedulingActionResult
  priorityBefore     Int?
  priorityAfter      Int?
  factor             Int?
  conflictRecomputed Boolean                       @default(false)
  pausedUntil        DateTime?
  reasonCode         String?
  errorCode          String?
  occurredAt         DateTime                      @default(now())

  @@index([accountId, occurredAt])
  @@index([actionType, occurredAt])
  @@index([result, occurredAt])
  @@index([occurredAt])
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model RemoteBackupRecord {
  id           Int      @id @default(autoincrement())
  status       String
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  fileName     String?
  fileSize     BigInt?
  deletedCount Int      @default(0)
  deletedFiles Json?
  errorMessage String?  @db.Text

  @@index([startedAt])
  @@index([status, startedAt])
}

model GroupAlertSetting {
  groupId      Int      @id
  alertEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AccountAlertCandidate {
  accountId       Int
  account         Sub2ApiAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ruleId          Int
  rule            AccountAlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  windowStartedAt DateTime
  lastTriggeredAt DateTime
  triggerCount    Int              @default(1)
  active           Boolean          @default(false)
  adjustmentLevel  Int              @default(0)
  recoveryNormalCount Int           @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@id([accountId, ruleId])
}

model AccountPriorityAdjustment {
  accountId        Int            @id
  account          Sub2ApiAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceAccountId  String
  expectedPriority Int?
  basePriority     Int?
  adjustedPriority Int?
  restoreExpectedPriority Int?
  restoreTargetPriority Int?
  appliedFactors  Int[]          @default([])
  factor           Int
  status           String         @default("PENDING")
  lastError        String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model User {
  id                  Int       @id @default(autoincrement())
  username            String    @unique
  password            String
  sessionVersion      Int       @default(1)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
