DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# 独立的 Sub2API PostgreSQL 只读账号，仅供服务端账号可观测采集使用
SUB2API_DATABASE_URL="postgresql://READONLY_USER:PASSWORD@SUB2API_DB_HOST:5432/SUB2API_DATABASE?schema=public"
SUB2API_PRIORITY_API_BASE_URL="https://sub2api.example.invalid"
SUB2API_RELAY_MONITOR_PRIORITY_SECRET="replace-with-a-32-byte-minimum-random-secret"
APP_ENCRYPTION_KEY="replace-with-32-byte-minimum-random-secret"
SESSION_SECRET="replace-with-a-different-32-byte-minimum-random-secret"
CRON_SECRET="replace-with-cron-secret"
NEXT_PUBLIC_APP_NAME="Relay Status Monitor"

# Sub2API 管理员启动票据交换（仅服务端使用）
SUB2API_ADMIN_EXCHANGE_BASE_URL="https://sub2api.example.invalid"
SUB2API_ADMIN_EXCHANGE_SECRET="replace-with-a-32-byte-minimum-random-secret"
RSM_ADMIN_SESSION_TTL_SECONDS="259200"

# 基础初始化管理员（运行 pnpm db:seed 时使用，用户名固定为 admin）
ADMIN_PASSWORD="replace-with-a-local-admin-password"
